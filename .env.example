#
# Obsidian MCP Server configuration
#
# Usage:
#   1. Copy this file to .env
#   2. Replace placeholder values with your real credentials and settings
#   3. Keep .env out of version control (already ignored)
#

# Git repository containing your Obsidian vault
# Supports GitHub, GitLab, Bitbucket, and self-hosted git providers
VAULT_REPO=https://github.com/yourusername/your-vault-repo.git

# Branch to deploy (typically main or master)
VAULT_BRANCH=main

# Git Personal Access Token
# Provider is auto-detected from repository URL:
#   - GitHub: Personal Access Token with 'repo' scope (ghp_...)
#   - GitLab: Personal Access Token with 'api' scope (glpat_...)
#   - Bitbucket: App Password with repository read/write
#   - Self-hosted: Personal Access Token or password (also requires GIT_USERNAME)
GIT_TOKEN=your_token_here

# Git username (only required for self-hosted/generic git providers)
# Leave commented out for GitHub, GitLab, or Bitbucket
# GIT_USERNAME=your_username

# Local directory where vault will be cloned (optional)
# Default: ./vault-local (native) or /app/vaults/vault-local (Docker)
# LOCAL_VAULT_PATH=/custom/path/to/vault

# Markdown path template for journal entries (supports {{date}})
JOURNAL_PATH_TEMPLATE=Journal/{{date}}.md

# Date format used when expanding {{date}} in journal paths
JOURNAL_DATE_FORMAT=YYYY-MM-DD

# Heading where automated journal entries are appended
JOURNAL_ACTIVITY_SECTION="## Activity"

# Template file used when creating new journal entries
JOURNAL_FILE_TEMPLATE=Templates/Daily Note.md

# OAuth client configuration shared with your MCP client
OAUTH_CLIENT_ID=obsidian-mcp-client
OAUTH_CLIENT_SECRET=replace_me_with_secret

# Token used to authorize yourself during OAuth registration. Grants read and
# write access to the vault.
PERSONAL_AUTH_TOKEN=replace_me_with_personal_token

# Optional second login token that grants READ-ONLY access: a client that logs
# in with it is never offered a tool that changes the vault.
# Generate it the same way as the others (openssl rand -hex 32); it must not be
# the same value as PERSONAL_AUTH_TOKEN. Restart the server after setting it.
# PERSONAL_AUTH_TOKEN_RO=replace_me_with_a_different_token

# Optional fixed bearer tokens (comma-separated) for clients that can only send
# an Authorization header. The first list is read-and-write, the second is
# read-only. A token in both lists is treated as read-only.
# MCP_STATIC_BEARER_TOKENS=
# MCP_STATIC_BEARER_TOKENS_RO=

# Base URL for the deployed server (update for production)
BASE_URL=http://localhost:3000

# Session lifetime in milliseconds (default: 24 hours)
SESSION_EXPIRY_MS=86400000

# AWS region used for CDK deployment
AWS_REGION=eu-west-1

# ─── Vault guards ────────────────────────────────────────────────────────────

# Vault-relative hooks directory, applied as core.hooksPath after clone. Lets a
# vault carry its own commit hooks (e.g. gitleaks) so writes made by this server
# are checked the same way a local commit would be.
VAULT_HOOKS_PATH=.githooks

# Comma-separated glob patterns refused for writes. Supports * and **.
# Defaults to CLAUDE.md, AGENTS.md, .githooks/**, .github/**, .gitignore,
# .gitattributes — files that govern how agents behave, which a remote client
# should not be able to rewrite. Reads are unaffected.
# VAULT_PROTECTED_PATHS=CLAUDE.md,90-Meta/**,.githooks/**

# Comma-separated allowlist of tool names. Unset registers everything.
# Skipped tools are absent from tools/list entirely.
# EXPOSED_TOOLS=read-note,read-notes,search-vault,capture-inbox,add-task,log-journal-entry

# Files describing vault organisation, exposed as the vault-readme resource.
# Defaults to README.md,CLAUDE.md,AGENTS.md; all that exist are concatenated.
# VAULT_GUIDANCE_FILES=CLAUDE.md,90-Meta/conventions.md

# ─── Note conventions ────────────────────────────────────────────────────────

# 'detailed' (default) = timestamped subheading with topics/outputs/project.
# 'bullet' = a single dated line, for journals kept as a running list.
# JOURNAL_ENTRY_STYLE=bullet

# Folder holding note templates, filled at runtime so the vault stays the
# single source of truth for structure.
# TEMPLATES_DIR=90-Meta/templates

# Quick-capture folder and the template capture-inbox fills (relative to
# TEMPLATES_DIR). A missing template is not fatal — capture still succeeds.
# INBOX_DIR=00-Inbox
# INBOX_TEMPLATE=reference.md

# Task list and the heading new tasks land under by default.
# TASKS_PATH=10-Tasks/TASKS.md
# TASKS_DEFAULT_SECTION=## Now

# Recorded as `source:` in frontmatter of notes this server writes, so a later
# reader can tell which client produced a note and treat it accordingly.
# NOTE_SOURCE=chatgpt
